{
  "manifest_version": 3,
  "name": "PRTG Map Studio",
  "version": "1.0.0",
  "description": "Build and push PRTG map objects/dashboards to any PRTG server you sign in to.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open PRTG Map Studio"
  },
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": ["preview-sandbox.html"]
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
